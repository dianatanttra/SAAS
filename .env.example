# .env.example
# ---------------------------------------------------------------
# Copy this file and rename it to .env
#
#   Windows (Command Prompt):  copy .env.example .env
#   Windows (PowerShell):      Copy-Item .env.example .env
#   Mac / Linux:               cp .env.example .env
#
# Then fill in every value below.
# NEVER commit your actual .env file to GitHub — it contains secrets.
# ---------------------------------------------------------------

# Port the server runs on locally
PORT=3000

# A long random secret used to sign session cookies.
# Generate one by running this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_minimum_30_characters

# PIN the Sports Director uses to log into the admin dashboard.
# Choose any 4-8 digit number. Keep it private.
ADMIN_PIN=replace_with_your_chosen_pin

# ---------------------------------------------------------------
# GOOGLE OAUTH CREDENTIALS
# ---------------------------------------------------------------
# See Section 3 Step 5 of the Handoff Document for full setup steps.
#
# IMPORTANT — read before proceeding:
# The sports department Google Cloud project is managed by the original
# developer (Diana). Access will be shared once approved by the director.
#
# Until then, create your OWN temporary credentials for local development:
#   1. Go to console.cloud.google.com
#   2. Create a new project (name it anything, e.g. "SAAS-Dev-Local")
#   3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   4. Authorised redirect URI: http://localhost:3000/auth/google/callback
#   5. Paste the Client ID and Secret below
#
# When you are given access to the real sports department project,
# swap these values for the official credentials.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# The base URL of the app.
# Keep this as http://localhost:3000 for local development.
# Change to your live deployment URL (Railway or Render) when deploying.
BASE_URL=http://localhost:3000

# Path to the SQLite database file.
# Leave this unchanged for local development.
# For production: set to /app/saas.db (after adding a persistent volume).
DB_PATH=./saas.db
