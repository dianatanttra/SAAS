<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SAAS Admin — Summary</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @media (max-width: 767px) {
      .filter-row { flex-direction: column !important; }
      .filter-row input,
      .filter-row select,
      .filter-row button,
      .filter-row a { width: 100% !important; }
      .card-header { flex-direction: column !important; align-items: flex-start !important; gap: 8px; }
      .card-header a { width: 100%; text-align: center; }
    }
    textarea, input[type="text"], input[type="date"] {
      font-size: 16px !important;
    }
  </style>
</head>
<body class="bg-light">

<%- include('../partials/admin-nav', { pendingCount, admin, active: 'summary' }) %>

<div class="container-fluid py-3 px-3">

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0">Approved Summary</h5>
  </div>

  <!-- Filters -->
  <div class="card mb-3">
    <div class="card-body py-2">
      <div class="d-flex gap-2 flex-wrap filter-row align-items-center">
        <input type="text" id="summarySearch" class="form-control form-control-sm"
          placeholder="Search student..." style="width:200px">
        <div class="d-flex align-items-center gap-1">
          <label class="form-label mb-0 small text-muted text-nowrap">From</label>
          <input type="date" id="dateFrom" class="form-control form-control-sm" style="width:150px">
        </div>
        <div class="d-flex align-items-center gap-1">
          <label class="form-label mb-0 small text-muted text-nowrap">To</label>
          <input type="date" id="dateTo" class="form-control form-control-sm" style="width:150px">
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">Clear</button>
        <a href="/admin/export" class="btn btn-success btn-sm">⬇ Export Excel</a>
      </div>
    </div>
  </div>

  <% if (summaries.length === 0) { %>
    <div class="alert alert-info">No approved entries yet.</div>
  <% } else { %>
    <% summaries.forEach(s => { %>
    <div class="card mb-4 summary-card"
      data-name="<%= s.full_name.toLowerCase() %>"
      data-submitted="<%= s.submitted_at %>">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <strong><%= s.full_name %></strong>
          <span class="text-muted ms-2 small">
            <%= s.roll_number %> | <%= s.year %> <%= s.stream %> Div <%= s.division %>
          </span><br>
          <small class="text-muted"><%= s.sport_name %> — <%= s.event_name %></small>
        </div>
        <a href="/admin/report/<%= s.request_id %>"
          class="btn btn-sm btn-outline-primary mt-1 mt-md-0"
          target="_blank">🖨 Print Report</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-bordered mb-0">
            <thead class="table-light">
              <tr>
                <th>Course Code</th>
                <th>Subject</th>
                <th>Total Lectures Approved</th>
              </tr>
            </thead>
            <tbody>
              <% s.totals.forEach(t => { %>
              <tr>
                <td><code><%= t.course_code %></code></td>
                <td><%= t.subject %></td>
                <td class="fw-bold"><%= t.total_lectures %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% }) %>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const summarySearch = document.getElementById('summarySearch');
  const dateFrom = document.getElementById('dateFrom');
  const dateTo = document.getElementById('dateTo');

  function filterSummary() {
    const search = summarySearch.value.toLowerCase();
    const from = dateFrom.value ? new Date(dateFrom.value) : null;
    const to = dateTo.value ? new Date(dateTo.value + 'T23:59:59') : null;

    document.querySelectorAll('.summary-card').forEach(card => {
      const name = card.dataset.name || '';
      const submitted = card.dataset.submitted ? new Date(card.dataset.submitted) : null;
      const matchName = !search || name.includes(search);
      const matchFrom = !from || !submitted || submitted >= from;
      const matchTo = !to || !submitted || submitted <= to;
      card.style.display = matchName && matchFrom && matchTo ? '' : 'none';
    });
  }

  function clearFilters() {
    summarySearch.value = '';
    dateFrom.value = '';
    dateTo.value = '';
    filterSummary();
  }

  summarySearch.addEventListener('input', filterSummary);
  dateFrom.addEventListener('change', filterSummary);
  dateTo.addEventListener('change', filterSummary);
</script>
</body>
</html>