<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SAAS — Submit Request</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .sidebar { min-width: 240px; max-width: 240px; }
    @media (max-width: 768px) { .sidebar { min-width: 100%; max-width: 100%; } }
    .char-counter { font-size: 0.78rem; }
    .char-counter.too-short { color: #dc3545; }
    .char-counter.ok { color: #198754; }
  </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-primary px-3">
  <span class="navbar-brand fw-bold">SAAS</span>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white small d-none d-md-inline"><%= student.full_name %></span>
    <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
  </div>
</nav>

<div id="sessionWarning" class="alert alert-warning alert-dismissible d-none mb-0 rounded-0">
  !! Your session has expired. <strong>Please <a href="/login" target="_blank">log in again</a> in a new tab</strong> before submitting — your form data will not be lost.
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

<div class="d-flex flex-column flex-md-row gap-3 p-3" style="max-width:1100px;margin:auto">

  <!-- Sidebar -->
  <div class="sidebar">
    <div class="card">
      <div class="card-header fw-semibold small">My Past Requests</div>
      <div class="card-body p-2">
        <% if (pastRequests.length === 0) { %>
          <p class="text-muted small mb-0">No requests yet.</p>
        <% } else { %>
          <% pastRequests.forEach(r => { %>
            <a href="/status/<%= r.status_token %>" class="d-block text-decoration-none mb-2 p-2 rounded border bg-white">
              <div class="fw-semibold small"><%= r.sport_name %></div>
              <div class="text-muted" style="font-size:0.75rem"><%= r.event_name %></div>
              <div class="text-muted" style="font-size:0.72rem"><%= new Date(r.submitted_at).toLocaleDateString() %></div>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Form -->
  <div class="flex-grow-1">
    <h5 class="fw-bold mb-3">Sports Attendance Request</h5>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div id="overlapWarning" class="alert alert-warning d-none">
    ⚠️ Two entries have overlapping times on the same date. Please fix before submitting.
    </div>
    <div id="restoredNotice" class="alert alert-info alert-dismissible fade show d-none">
    📋 Your previous form data has been restored after re-login.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <form method="POST" action="/submit" id="mainForm">

      <!-- Student Details -->
      <div class="card mb-3">
        <div class="card-header fw-semibold">Student Details</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" value="<%= student.full_name %>" disabled>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="text" class="form-control" value="<%= student.email %>" disabled>
            </div>
            <div class="col-md-6">
              <label class="form-label">Roll Number <span class="text-danger">*</span></label>
              <input type="text" name="roll_number" class="form-control" value="<%= student.roll_number || '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">UID <span class="text-danger">*</span></label>
              <input type="text" name="uid" class="form-control" value="<%= student.uid || '' %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Year <span class="text-danger">*</span></label>
              <select name="year" class="form-select" required>
                <option value="">Select</option>
                <% ['FY','SY','TY'].forEach(y => { %>
                  <option value="<%= y %>" <%= student.year === y ? 'selected' : '' %>><%= y %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Stream <span class="text-danger">*</span></label>
              <input type="text" name="stream" class="form-control" value="<%= student.stream || '' %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Division <span class="text-danger">*</span></label>
              <select name="division" class="form-select" required>
                <option value="">Select</option>
                <% ['A','B','C','D','E'].forEach(d => { %>
                  <option value="<%= d %>" <%= student.division === d ? 'selected' : '' %>><%= d %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Sport Details -->
      <div class="card mb-3">
        <div class="card-header fw-semibold">Sport & Event Details</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Sport Name <span class="text-danger">*</span></label>
              <input type="text" name="sport_name" class="form-control"
                list="sportsList" placeholder="e.g. Football" required autocomplete="off"
                value="<%= prefill.sport_name %>">
              <datalist id="sportsList">
                <option value="Football">
                <option value="Cricket">
                <option value="Basketball">
                <option value="Volleyball">
                <option value="Badminton">
                <option value="Table Tennis">
                <option value="Tennis">
                <option value="Athletics">
                <option value="Swimming">
                <option value="Chess">
                <option value="Kabaddi">
                <option value="Kho-Kho">
                <option value="Hockey">
                <option value="Handball">
                <option value="Throwball">
              </datalist>
            </div>
            <div class="col-md-6">
              <label class="form-label">Event / Tournament <span class="text-danger">*</span></label>
              <input type="text" name="event_name" class="form-control"
                list="eventsList" placeholder="e.g. Inter-collegiate 2025" required autocomplete="off
                value="<%= prefill.event_name %>">
              <datalist id="eventsList">
                <option value="Inter-collegiate Tournament">
                <option value="Intra-college Tournament">
                <option value="University Games">
                <option value="State Championship">
                <option value="National Championship">
                <option value="District Championship">
                <option value="Zonal Tournament">
                <option value="Invitational Tournament">
                <option value="Annual Sports Meet">
                <option value="Practice Match">
                <option value="Selection Trial">
              </datalist>
            </div>
            <div class="col-12">
              <label class="form-label">
                Reason for Absence <span class="text-danger">*</span>
                <span class="char-counter too-short ms-2" id="reasonCounter">0 / min 10</span>
              </label>
              <textarea name="reason" id="reasonField" class="form-control" rows="2"
                required minlength="10" placeholder="Briefly explain why you were absent"><%= prefill.reason %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Lecture Entries -->
      <div class="card mb-3">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
          Lecture Entries
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-bordered mb-0" id="entriesTable">
              <thead class="table-light">
                <tr>
                  <th>Date</th>
                  <th>Start</th>
                  <th>End</th>
                  <th>Subject</th>
                  <th>Course Code</th>
                  <th>Lectures</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="entriesBody"></tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary m-2" onclick="addRow()">+ Add Row</button>
          </div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-3">
        <button type="submit" id="submitBtn" class="btn btn-primary px-4" disabled>Submit Request</button>
        <span class="text-muted small" id="submitHint">Fill all required fields to enable submit</span>
      </div>
      <div id="prefillData" data-entries="<%- JSON.stringify(prefill.entries) %>" style="display:none"></div>
    </form>
  </div>
</div>

<!-- Course code datalist -->
<datalist id="courseCodes">
  <% courseCodes.forEach(c => { %>
    <option value="<%= c.course_code %>"><%= c.subject %></option>
  <% }) %>
</datalist>

<script>
  let rowIndex = 0;
  const today = new Date().toISOString().split('T')[0];

  // ── Add blank lecture row ──
  function addRow() {
    addRowWithData({});
  }

  // ── Add row with optional prefill data ──
  function addRowWithData(e) {
    // Max 14 rows
    if (document.querySelectorAll('#entriesBody tr').length >= 14) {
        alert('Maximum 14 lecture entries allowed per submission.');
        return;
    }
    const tbody = document.getElementById('entriesBody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="date" name="entries[${rowIndex}][date]"
        class="form-control form-control-sm entry-date"
        max="${today}" value="${e.date || ''}" required></td>
      <td><input type="time" name="entries[${rowIndex}][start_time]"
        class="form-control form-control-sm entry-start"
        min="06:00" max="21:00" value="${e.start_time || '08:00'}" required></td>
      <td><input type="time" name="entries[${rowIndex}][end_time]"
        class="form-control form-control-sm entry-end"
        min="06:00" max="21:00" value="${e.end_time || '09:00'}" required></td>
      <td><input type="text" name="entries[${rowIndex}][subject]"
        class="form-control form-control-sm entry-text"
        value="${e.subject || ''}" required></td>
      <td><input type="text" name="entries[${rowIndex}][course_code]"
        class="form-control form-control-sm entry-text" list="courseCodes"
        value="${e.course_code || ''}" required></td>
      <td><input type="number" name="entries[${rowIndex}][lectures]"
        class="form-control form-control-sm entry-text"
        min="1" max="10" value="${e.lectures || ''}" required></td>
      <td><button type="button" class="btn btn-sm btn-outline-danger"
        onclick="this.closest('tr').remove(); checkSubmitReady();">✕</button></td>
    `;
    tbody.appendChild(tr);
    rowIndex++;

    // Attach listeners to new row inputs
    tr.querySelectorAll('input').forEach(inp => {
      inp.addEventListener('change', () => {
        if (inp.classList.contains('entry-date')) checkSunday(inp);
        if (inp.classList.contains('entry-start') || inp.classList.contains('entry-end')) {
          checkOverlaps();
          checkDuration(inp.closest('tr'));
        }
        if (endMins - startMins > 300) {
            return renderError(`Lecture duration cannot exceed 5 hours (row: ${e.date} ${e.subject}).`);
            }
        checkSubmitReady();
      });
      inp.addEventListener('input', checkSubmitReady);
    });

    checkSubmitReady();
  }

  // ── Load prefilled rows or one blank row on page load ──
    const prefillEntries = JSON.parse(document.getElementById('prefillData').dataset.entries || '[]');  if (prefillEntries.length > 0) {
    prefillEntries.forEach(e => addRowWithData(e));
  } else {
    addRow();
  }

  // Trigger reason counter if prefilled
  const reasonEl = document.getElementById('reasonField');
  if (reasonEl.value.trim().length > 0) {
    reasonEl.dispatchEvent(new Event('input'));
  }

  // ── Date Validator ──
  function checkSunday(input) {
    if (!input.value) return;

    const selected = new Date(input.value + 'T00:00:00');

    // Sunday check
    if (selected.getDay() === 0) {
        showInlineError(input, 'Sundays are not allowed.');
        input.value = '';
        return;
    }

    // 60 days in the past check
    const sixtyDaysAgo = new Date();
    sixtyDaysAgo.setDate(sixtyDaysAgo.getDate() - 60);
    if (selected < sixtyDaysAgo) {
        showInlineError(input, 'Date cannot be more than 60 days in the past.');
        input.value = '';
        return;
    }

    clearInlineError(input);
    }

  // ── Max 5 hour duration check ──
  function checkDuration(row) {
    const start = row.querySelector('.entry-start')?.value;
    const end = row.querySelector('.entry-end')?.value;
    const endInput = row.querySelector('.entry-end');
    if (!start || !end) return;
    const duration = toMins(end) - toMins(start);
    if (duration > 300) {
      showInlineError(endInput, 'Max duration is 5 hours.');
    } else if (duration <= 0) {
      showInlineError(endInput, 'End time must be after start time.');
    } else {
      clearInlineError(endInput);
    }
  }

  // ── Overlap check ──
  function checkOverlaps() {
    const rows = document.querySelectorAll('#entriesBody tr');
    const data = [];
    rows.forEach(row => {
      const date  = row.querySelector('.entry-date')?.value;
      const start = row.querySelector('.entry-start')?.value;
      const end   = row.querySelector('.entry-end')?.value;
      if (date && start && end) data.push({ date, start, end });
    });
    for (let i = 0; i < data.length; i++) {
      for (let j = i + 1; j < data.length; j++) {
        if (data[i].date !== data[j].date) continue;
        const s1 = toMins(data[i].start), e1 = toMins(data[i].end);
        const s2 = toMins(data[j].start), e2 = toMins(data[j].end);
        if (s1 < e2 && s2 < e1) {
          document.getElementById('overlapWarning').classList.remove('d-none');
          return;
        }
      }
    }
    document.getElementById('overlapWarning').classList.add('d-none');

    // Max 5 hour duration check
    rows.forEach(row => {
        const start = row.querySelector('.entry-start')?.value;
        const end   = row.querySelector('.entry-end')?.value;
        if (start && end) {
        const duration = toMins(end) - toMins(start);
        if (duration > 300) {
            showInlineError(row.querySelector('.entry-end'), 'Max duration is 5 hours.');
        } else {
            clearInlineError(row.querySelector('.entry-end'));
        }
        }
    });
  }


  function toMins(t) {
    const [h, m] = t.split(':').map(Number);
    return h * 60 + m;
  }

  // ── Reason counter ──
  document.getElementById('reasonField').addEventListener('input', function() {
    const len = this.value.trim().length;
    const counter = document.getElementById('reasonCounter');
    if (len < 10) {
      counter.textContent = len + ' / min 10';
      counter.className = 'char-counter too-short ms-2';
    } else {
      counter.textContent = len + ' ✓';
      counter.className = 'char-counter ok ms-2';
    }
    checkSubmitReady();
  });

  // ── Submit button enable/disable ──
  function checkSubmitReady() {
    const submitBtn = document.getElementById('submitBtn');
    const roll = document.querySelector('[name="roll_number"]').value.trim();
    const uid = document.querySelector('[name="uid"]').value.trim();
    const year = document.querySelector('[name="year"]').value;
    const stream = document.querySelector('[name="stream"]').value.trim();
    const division = document.querySelector('[name="division"]').value;
    const sport = document.querySelector('[name="sport_name"]').value.trim();
    const event = document.querySelector('[name="event_name"]').value.trim();
    const reason = document.getElementById('reasonField').value.trim();
    const hasRows = document.querySelectorAll('#entriesBody tr').length > 0;

    let rowsValid = true;
    document.querySelectorAll('#entriesBody tr').forEach(row => {
      row.querySelectorAll('input').forEach(inp => {
        if (inp.required && !inp.value.trim()) rowsValid = false;
      });
      // Also check duration per row
      const start = row.querySelector('.entry-start')?.value;
      const end = row.querySelector('.entry-end')?.value;
      if (start && end) {
        const dur = toMins(end) - toMins(start);
        if (dur <= 0 || dur > 300) rowsValid = false;
      }
    });

    const ready = roll && uid && year && stream && division &&
                  sport && event && reason.length >= 10 &&
                  hasRows && rowsValid;

    submitBtn.disabled = !ready;
    submitBtn.title = ready ? '' : 'Please fill in all required fields (reason needs at least 10 characters)';
  }

  checkSubmitReady();

  // ── Inline error helpers ──
  function showInlineError(input, msg) {
    clearInlineError(input);
    const div = document.createElement('div');
    div.className = 'text-danger small mt-1 inline-err';
    div.textContent = msg;
    input.parentNode.appendChild(div);
    input.classList.add('is-invalid');
  }

  function clearInlineError(input) {
    const existing = input.parentNode.querySelector('.inline-err');
    if (existing) existing.remove();
    input.classList.remove('is-invalid');
  }

  // ── Session check on submit click ──
  document.getElementById('mainForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    // Final overlap check
    const rows = document.querySelectorAll('#entriesBody tr');
    const data = [];
    rows.forEach(row => {
      const date  = row.querySelector('.entry-date')?.value;
      const start = row.querySelector('.entry-start')?.value;
      const end   = row.querySelector('.entry-end')?.value;
      if (date && start && end) data.push({ date, start, end });
    });
    for (let i = 0; i < data.length; i++) {
      for (let j = i + 1; j < data.length; j++) {
        if (data[i].date !== data[j].date) continue;
        const s1 = toMins(data[i].start), e1 = toMins(data[i].end);
        const s2 = toMins(data[j].start), e2 = toMins(data[j].end);
        if (s1 < e2 && s2 < e1) {
          alert('Two entries have overlapping times. Please fix before submitting.');
          return;
        }
      }
    }

    // Check session before submitting
    try {
      const res = await fetch('/auth/check');
      if (res.status === 401) {
        saveFormToStorage();
        window.location.href = '/login';
        return;
      }
    } catch (e) { /* network error — let form try anyway */ }

    this.submit();
  });

  // ── Save/restore form to sessionStorage ──
  function saveFormToStorage() {
    const data = {
      roll_number: document.querySelector('[name="roll_number"]').value,
      uid: document.querySelector('[name="uid"]').value,
      year: document.querySelector('[name="year"]').value,
      stream: document.querySelector('[name="stream"]').value,
      division: document.querySelector('[name="division"]').value,
      sport_name: document.querySelector('[name="sport_name"]').value,
      event_name: document.querySelector('[name="event_name"]').value,
      reason: document.getElementById('reasonField').value,
    };
    sessionStorage.setItem('saas_form_draft', JSON.stringify(data));
  }

  function restoreFormFromStorage() {
    const raw = sessionStorage.getItem('saas_form_draft');
    if (!raw) return;
    try {
      const data = JSON.parse(raw);
      if (data.roll_number) document.querySelector('[name="roll_number"]').value = data.roll_number;
      if (data.uid) document.querySelector('[name="uid"]').value = data.uid;
      if (data.year) document.querySelector('[name="year"]').value = data.year;
      if (data.stream) document.querySelector('[name="stream"]').value = data.stream;
      if (data.division) document.querySelector('[name="division"]').value = data.division;
      if (data.sport_name) document.querySelector('[name="sport_name"]').value = data.sport_name;
      if (data.event_name) document.querySelector('[name="event_name"]').value = data.event_name;
      if (data.reason) {
        document.getElementById('reasonField').value = data.reason;
        document.getElementById('reasonField').dispatchEvent(new Event('input'));
      }
      sessionStorage.removeItem('saas_form_draft');
      document.getElementById('restoredNotice').classList.remove('d-none');
    } catch(e) {}
    checkSubmitReady();
  }

  restoreFormFromStorage();

  // Background session check every 4 minutes
  let sessionWarned = false;
  async function checkSession() {
    try {
      const res = await fetch('/auth/check');
      if (res.status === 401 && !sessionWarned) {
        sessionWarned = true;
        document.getElementById('sessionWarning').classList.remove('d-none');
      }
    } catch (e) {}
  }
  setInterval(checkSession, 4 * 60 * 1000);
</script>
</body>
</html>