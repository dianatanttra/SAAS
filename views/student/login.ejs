<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SAAS — Student Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="card shadow p-4" style="max-width:400px;width:100%">
    <h4 class="text-center mb-1 fw-bold">SAAS</h4>
    <p class="text-center text-muted mb-4">Sports Attendance Approval System</p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <a href="/auth/google" class="btn btn-danger w-100 mb-3">
      Sign in with Google
    </a>
    <p class="text-center text-muted small">Use your <strong>@xaviers.edu.in</strong> college account</p>
  </div>
</body>
</html>